---
const year = new Date().getFullYear();

const navLinks = [
  { label: 'Accueil', href: '/' },
  { label: 'Acheter', href: '/biens?type=vente' },
  { label: 'Louer', href: '/biens?type=location' },
  { label: 'Contact', href: '/contact' },
];

const resourceLinks = [
  { label: 'Questions fréquentes', href: '/#faq' },
  { label: "Voir l'admin démo", href: '/admin' },
  { label: 'Mentions légales', href: '/mentions-legales' },
];
---

<footer class="border-t border-white/10 bg-primary">
  <div class="container flex justify-between gap-10 py-16 text-sm text-gray-300">
    <div class="flex flex-col gap-4 w-md">
      <a href="/" class="text-xl font-bold text-white">Larisimmo</a>
      <p>On vous accompagne dans l'achat ou la location, pour tous types de biens, partout en France.</p>
    </div>

    <div class="flex w-full justify-end gap-20">
      <div class="flex flex-col gap-3 px-12">
        <h3 class="font-semibold text-white">Navigation</h3>
        <ul class="flex flex-col gap-2" role="list">
          {
            navLinks.map((link) => (
              <li class="hover:text-accent-secondary">
                <a href={link.href} class="hover:text-accent-secondary">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col gap-3 px-12">
        <h3 class="font-semibold text-white">Ressources</h3>
        <ul class="flex flex-col gap-2" role="list">
          {
            resourceLinks.map((link) => (
              <li class="hover:text-accent-secondary">
                <a href={link.href} class="hover:text-accent-secondary">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container flex flex-col items-center gap-4 py-4 text-sm text-gray-500 md:flex-row md:justify-between">
      <a href="https://nocdev.fr" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center rounded-full bg-gray-900 p-2">
        <img src="/logo.svg" alt="Nocdev logo" width="24" height="24" />
      </a>

      <p class="text-white">© {year} Nocdev</p>
    </div>
  </div>
</footer>
