---
import properties from '../../data/biens.json';
import type { Property } from '../../types/property';

interface Props {
  transaction?: string;
  ville?: string;
  type?: string;
  prix?: string;
}

const { transaction = '', ville = '', type = '', prix = '' } = Astro.props;

const transactions = [
  { label: 'Achat', value: 'vente' },
  { label: 'Location', value: 'location' },
];

const cities = [...new Set((properties as Property[]).map((p) => p.ville))].sort();
const propertyTypes = ['Appartement', 'Maison'];
const priceRanges = [
  { label: "Jusqu'à 200 000 €", value: '0-200000' },
  { label: '200 000 € - 400 000 €', value: '200000-400000' },
  { label: '400 000 € - 600 000 €', value: '400000-600000' },
  { label: 'Plus de 600 000 €', value: '600000-' },
];
---

<div class="flex flex-col gap-1">
  <label for="search-transaction" class="text-xs font-semibold text-gray-500">Achat ou location</label>
  <select
    id="search-transaction"
    name="transaction"
    class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-primary lg:w-40"
  >
    <option value="">Peu importe</option>
    {
      transactions.map((t) => (
        <option value={t.value} selected={t.value === transaction}>
          {t.label}
        </option>
      ))
    }
  </select>
</div>

<div class="flex flex-col gap-1">
  <label for="search-city" class="text-xs font-semibold text-gray-500">Choisir la localisation</label>
  <select
    id="search-city"
    name="ville"
    class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-primary lg:w-56"
  >
    <option value="">Toutes les localisations</option>
    {
      cities.map((c) => (
        <option value={c} selected={c === ville}>
          {c}
        </option>
      ))
    }
  </select>
</div>

<div class="flex flex-col gap-1">
  <label for="search-type" class="text-xs font-semibold text-gray-500">Type de bien</label>
  <select
    id="search-type"
    name="type"
    class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-primary lg:w-40"
  >
    <option value="">Tout type</option>
    {
      propertyTypes.map((t) => (
        <option value={t} selected={t === type}>
          {t}
        </option>
      ))
    }
  </select>
</div>

<div class="flex flex-col gap-1">
  <label for="search-price" class="text-xs font-semibold text-gray-500">Budget</label>
  <select
    id="search-price"
    name="prix"
    class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-primary lg:w-52"
  >
    <option value="">Tous les prix</option>
    {
      priceRanges.map((r) => (
        <option value={r.value} selected={r.value === prix}>
          {r.label}
        </option>
      ))
    }
  </select>
</div>
