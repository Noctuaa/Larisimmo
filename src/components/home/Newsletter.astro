---
import { Image } from 'astro:assets';
import homeImage from '../../assets/images/home-unsplash.jpg';
---

<section class="relative overflow-hidden bg-primary py-24">
  <Image
    src={homeImage}
    alt=""
    class="absolute inset-y-0 right-0 h-full w-3/5 object-cover md:w-3/5"
    widths={[640, 1024, 1600]}
    sizes="40vw"
    loading="lazy"
  />
  <div class="absolute inset-0 bg-linear-to-r from-primary via-primary to-transparent"></div>

  <div class="container relative flex flex-col items-start gap-6">
    <div>
      <h2 class="text-3xl font-bold text-white">Ne manquez aucun bien</h2>
      <p class="mt-3 max-w-md text-lg text-white/90">Recevez les nouvelles annonces qui correspondent à vos critères, directement par email.</p>
    </div>

    <form class="flex w-full max-w-md flex-col gap-3 sm:flex-row">
      <input
        type="email"
        required
        placeholder="Votre adresse email"
        class="w-full rounded-full bg-white px-4 py-3 text-sm text-black outline-none border border-gray-200 placeholder:text-gray-600"
      />
      <button
        type="submit"
        aria-label="S'inscrire"
        class="group flex items-center justify-center w-12 h-12 shrink-0 rounded-full bg-white text-primary cursor-pointer transition hover:opacity-90"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-arrow-right-icon lucide-arrow-right transition-transform group-hover:translate-x-0.5"
        >
          <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
        </svg>
      </button>
    </form>
  </div>
</section>
