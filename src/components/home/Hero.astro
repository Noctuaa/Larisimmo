---
import { Image } from 'astro:assets';
import homeImage from '../../assets/images/home-unsplash.jpg';
import SearchBar from './SearchBar.astro';
---

<section class="relative mx-auto h-svh w-full md:mt-(--nav-height) md:mb-[1.5vw] md:h-[calc(100svh-var(--nav-height)-1.5vw)] md:w-[97%]">
  <!-- Halos décoratifs : débordent du cadre, doivent rester en dehors du overflow-hidden -->
  <!--<div class="absolute -left-16 top-1/3 hidden h-72 w-72 rounded-full bg-accent-secondary/40 blur-3xl md:block"></div>
  <div class="absolute -bottom-16 -right-25 hidden h-96 w-96 rounded-full bg-accent/50 blur-3xl md:block"></div>-->

  <!-- imgbox : uniquement la photo (+ arrondi/dégradé, indissociables visuellement de la photo) -->
  <div
    class="imgbox absolute inset-0 overflow-hidden bg-slate-900
    before:content-[''] before:absolute before:inset-0 before:bg-black/40
    md:rounded-3xl md:before:bg-linear-to-r md:before:from-black/60 md:before:via-black/20 md:before:to-transparent"
  >
    <Image
      src={homeImage}
      alt="Maison en bois moderne"
      class="h-full w-full object-cover"
      widths={[640, 1024, 1600, 2000]}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="container-wide absolute inset-0 flex flex-col justify-center text-white">
    <h1 class="max-w-2xl font-bold text-4xl [text-shadow:0_1px_10px_rgb(0_0_0/0.6)] md:text-7xl md:leading-[1.2]">
      Trouvez le bien qui vous ressemble
    </h1>
    <p class="max-w-lg mt-4 text-lg text-white [text-shadow:0_1px_10px_rgb(0_0_0/0.6)]">
      On vous accompagne dans l'achat ou la location, pour tous types de biens, partout en France.
    </p>

    <!-- Mobile : suit le texte dans le flux centré. Desktop : redevient flottante près du bas, comme avant -->
    <div class="mt-8 md:absolute md:inset-x-0 md:bottom-30 md:mt-0 md:px-12">
      <SearchBar />
    </div>
  </div>
</section>
