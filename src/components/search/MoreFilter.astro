---
// #region - frontmatter
import { DPE_CLASSES } from '../../types/property';

import FilterSection from './filters/FilterSection.astro';
import FilterRange from './filters/FilterRange.vue';
import FilterChoice from './filters/FilterChoice.vue';
import FilterNumberRange from './filters/FilterNumberRange.vue';

interface Props {
  transaction?: string;
  type?: string;
  prixMin?: string;
  prixMax?: string;
  chambresMin?: string;
  chambresMax?: string;
  piecesMin?: string;
  piecesMax?: string;
  surfaceMin?: string;
  surfaceMax?: string;
  dpe?: string;
  meuble?: string;
  equipements?: string[];
}

const {
  transaction = '',
  type = '',
  prixMin = '',
  prixMax = '',
  chambresMin = '',
  chambresMax = '',
  piecesMin = '',
  piecesMax = '',
  surfaceMin = '',
  surfaceMax = '',
  dpe = '',
  meuble = '',
  equipements = [],
} = Astro.props;

const allEquipements = [
  'Parking',
  'Terrasse',
  'Jardin',
  'Piscine',
  'Ascenseur',
  'Cave',
  'Grenier',
  'Climatisation',
  'Cheminée',
  'Chauffage au sol',
  'Cuisine équipée',
];

// #endregion
---

<div class="flex flex-col gap-4 overflow-y-auto p-6">
  <!-- Transaction (achat/location) -->
  <FilterSection title="Achat ou location">
    <FilterChoice
      client:load
      name="transaction"
      options={[
        { label: 'Achat', value: 'vente' },
        { label: 'Location', value: 'location' },
      ]}
      selected={transaction}
    />
  </FilterSection>

  <!-- Type de bien (maison/appartement/chalet) -->
  <FilterSection title="Type de bien">
    <FilterChoice
      client:load
      name="type"
      options={[
        { label: 'Maison', value: 'Maison' },
        { label: 'Appartement', value: 'Appartement' },
        { label: 'Chalet', value: 'Chalet' },
      ]}
      selected={type}
    />
  </FilterSection>

  <!-- Prix (prixMin/prixMax) -->
  <FilterSection title="Prix">
    <FilterNumberRange client:load name="prix" unit="€" min={prixMin} max={prixMax} />
  </FilterSection>

  <!-- Chambres (chambresMin/chambresMax) -->
  <FilterSection title="Chambres">
    <FilterRange client:load name="chambres" min={chambresMin} max={chambresMax} />
  </FilterSection>

  <!-- Pièces (piecesMin/piecesMax) -->
  <FilterSection title="Pièces">
    <FilterRange client:load name="pieces" min={piecesMin} max={piecesMax} />
  </FilterSection>

  <!-- Surface (surfaceMin/surfaceMax) -->
  <FilterSection title="Surface">
    <FilterNumberRange client:load name="surface" unit="m²" min={surfaceMin} max={surfaceMax} />
  </FilterSection>

  <!-- Meuble (meuble) -->
  <FilterSection title="Meublé / Non meublé">
    <FilterChoice
      client:load
      name="meuble"
      options={[
        { label: 'Meublé', value: 'true' },
        { label: 'Non meublé', value: 'false' },
      ]}
      selected={meuble}
    />
  </FilterSection>

  <!-- DPE (classe minimale) -->
  <FilterSection title="Classe énergie">
    <FilterChoice client:load name="dpe" options={DPE_CLASSES.map((c) => ({ label: c, value: c }))} selected={dpe} />
  </FilterSection>

  <!-- Equipements -->
  <FilterSection title="Équipements">
    <FilterChoice
      client:load
      name="equipements"
      options={allEquipements.map((eq) => ({ label: eq, value: eq }))}
      selected={equipements}
      multiple
    />
  </FilterSection>
</div>
