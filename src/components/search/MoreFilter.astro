---
// #region - frontmatter
import { DPE_CLASSES } from '../../types/property';

import FilterSection from './FilterSection.astro';
import FilterRange from './FilterRange.astro';
import FilterChoice from './FilterChoice.vue';

interface Props {
  transaction?: string;
  type?: string;
  chambresMin?: string;
  chambresMax?: string;
  piecesMin?: string;
  piecesMax?: string;
  surfaceMin?: string;
  surfaceMax?: string;
  dpeMax?: string;
  meuble?: string;
  equipements?: string[];
  fieldClass: string;
  labelClass: string;
}

const {
  transaction = '',
  type = '',
  chambresMin = '',
  chambresMax = '',
  piecesMin = '',
  piecesMax = '',
  surfaceMin = '',
  surfaceMax = '',
  dpeMax = '',
  meuble = '',
  equipements = [],
  fieldClass,
  labelClass,
} = Astro.props;

const allEquipements = [
  'Parking',
  'Terrasse',
  'Jardin',
  'Piscine',
  'Ascenseur',
  'Cave',
  'Grenier',
  'Climatisation',
  'Cheminée',
  'Chauffage au sol',
  'Cuisine équipée',
];

// Un filtre compte pour 1 dès qu'il a une valeur (pour les plages : Min ou Max suffit)
const activeFilters = [transaction, type, chambresMin || chambresMax, piecesMin || piecesMax, surfaceMin || surfaceMax, meuble, dpeMax];
const activeCount = activeFilters.filter(Boolean).length + (equipements.length ? 1 : 0);
// #endregion
---

<button type="button" popovertarget="more-filters" class:list={[fieldClass, 'flex items-center gap-2 hover:bg-gray-50']}>
  Filtres
  {
    activeCount > 0 && (
      <span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1.5 text-xs font-bold text-white">{activeCount}</span>
    )
  }
</button>

<div popover id="more-filters" class="more-filters-popover">
  <div class="flex items-center justify-between border-b border-gray-100 px-6 py-3">
    <span class="text-lg font-bold text-primary">Tous les filtres</span>
    <button
      type="button"
      popovertarget="more-filters"
      popovertargetaction="hide"
      class="flex h-9 w-9 items-center justify-center rounded-full text-lg text-gray-700 hover:bg-gray-100"
      aria-label="Fermer"
    >
      ✕
    </button>
  </div>

  <div class="flex flex-col gap-4 overflow-y-auto p-6">
    <!-- Transaction (achat/location) -->
    <FilterSection title="Achat ou location">
      <FilterChoice
        client:load
        name="transaction"
        options={[
          { label: 'Achat', value: 'vente' },
          { label: 'Location', value: 'location' },
        ]}
        selected={transaction}
      />
    </FilterSection>

    <!-- Type de bien (maison/appartement/chalet) -->
    <FilterSection title="Type de bien">
      <FilterChoice
        client:load
        name="type"
        options={[
          { label: 'Maison', value: 'Maison' },
          { label: 'Appartement', value: 'Appartement' },
          { label: 'Chalet', value: 'Chalet' },
        ]}
        selected={type}
      />
    </FilterSection>

    <!-- Chambres (chambresMin/chambresMax) -->
    <FilterRange name="chambres" title="Chambres" min={chambresMin} max={chambresMax} />

    <!-- Pièces (piecesMin/piecesMax) -->
    <FilterRange name="pieces" title="Pièces" min={piecesMin} max={piecesMax} />

    <!-- Surface (surfaceMin/surfaceMax) -->
    <FilterSection title="Surface">
      <div class="flex gap-4">
        <div class="flex flex-col">
          <label for="filter-surface-min" class={labelClass}>Min.</label>
          <input type="number" id="filter-surface-min" name="surfaceMin" min="0" value={surfaceMin} class={fieldClass} />
        </div>
        <div class="flex flex-col">
          <label for="filter-surface-max" class={labelClass}>Max.</label>
          <input type="number" id="filter-surface-max" name="surfaceMax" min="0" value={surfaceMax} class={fieldClass} />
        </div>
      </div>
    </FilterSection>

    <!-- Meuble (meuble) -->
    <FilterSection title="Meublé / Non meublé">
      <FilterChoice
        client:load
        name="meuble"
        options={[
          { label: 'Meublé', value: 'true' },
          { label: 'Non meublé', value: 'false' },
        ]}
        selected={meuble}
      />
    </FilterSection>

    <!-- DPE max -->
    <FilterSection title="Classe énergie">
      <select name="dpe" class={fieldClass}>
        <option value="">Indifférent</option>
        {
          DPE_CLASSES.map((dpe) => (
            <option value={dpe} selected={dpe === dpeMax}>
              {dpe}
            </option>
          ))
        }
      </select>
    </FilterSection>

    <!-- Equipements -->
    <FilterSection title="Équipements">
      <FilterChoice client:load name="equipements" options={allEquipements.map((eq) => ({ label: eq, value: eq }))} selected={equipements} multiple />
    </FilterSection>
  </div>

  <style>
    .more-filters-popover {
      width: min(480px, 92vw);
      max-height: 80vh;

      flex-direction: column;
      margin: auto;
      border: none;
      border-radius: 0.75rem;
      padding: 0;
      box-shadow: 0 10px 40px rgb(0 0 0 / 0.15);
    }

    .more-filters-popover::backdrop {
      background: rgb(0 0 0 / 0.4);
    }

    /* TODO (Noc) : media query mobile pour passer en plein écran (width/height 100%, border-radius 0) */
  </style>
</div>
