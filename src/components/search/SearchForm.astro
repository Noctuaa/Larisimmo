---
// #region - frontmatter
import properties from '../../data/biens.json';
import type { Property } from '../../types/property';
import MoreFilter from './MoreFilter.astro';
import FilterTrigger from './FilterTrigger.vue';
import FilterButton from './FilterButton.vue';
import { countActiveFilters } from '../../utils/countActiveFilters';

interface Props {
  transaction?: string;
  ville?: string;
  type?: string;
  prixMin?: string;
  prixMax?: string;
  chambresMin?: string;
  chambresMax?: string;
  piecesMin?: string;
  piecesMax?: string;
  surfaceMin?: string;
  surfaceMax?: string;
  dpe?: string;
  meuble?: string;
  equipements?: string[];
}

const {
  transaction = '',
  ville = '',
  type = '',
  prixMin = '',
  prixMax = '',
  chambresMin = '',
  chambresMax = '',
  piecesMin = '',
  piecesMax = '',
  surfaceMin = '',
  surfaceMax = '',
  dpe = '',
  meuble = '',
  equipements = [],
} = Astro.props;

const activeCount = countActiveFilters({
  transaction,
  ville,
  type,
  prixMin,
  prixMax,
  chambresMin,
  chambresMax,
  piecesMin,
  piecesMax,
  surfaceMin,
  surfaceMax,
  dpe: dpe,
  meuble,
  equipements,
});

// Champs principaux (toujours visibles)
const transactions = [
  { label: 'Achat', value: 'vente' },
  { label: 'Location', value: 'location' },
];
const cities = [...new Set((properties as Property[]).map((p) => p.ville))].sort();
const propertyTypes = ['Appartement', 'Maison', 'Chalet'];

// #endregion
---

<form method="get" data-live class="search-form container flex flex-col gap-4 py-4 lg:flex-row lg:flex-wrap lg:items-end lg:gap-y-0">
  <!-- Champs principaux -->

  <!-- Ville -->
  <div class="flex flex-col gap-1">
    <label for="search-city" class="field-label">Choisir la localisation</label>
    <select id="search-city" name="ville" class="field w-full lg:w-56">
      <option value="">Toutes les localisations</option>
      {
        cities.map((c) => (
          <option value={c} selected={c === ville}>
            {c}
          </option>
        ))
      }
    </select>
  </div>

  <!-- Transaction -->
  <FilterTrigger client:load name="transaction" label="Achat ou location" placeholder="Peu importe" options={transactions} selected={transaction} />

  <!-- Type de bien -->
  <FilterTrigger
    client:load
    name="type"
    label="Type de bien"
    placeholder="Touts les types"
    options={propertyTypes.map((t) => ({ label: t, value: t }))}
    selected={type}
  />

  <FilterButton client:load initialCount={activeCount} />

  <!-- Filtres -->
  <MoreFilter
    transaction={transaction}
    type={type}
    prixMin={prixMin}
    prixMax={prixMax}
    chambresMin={chambresMin}
    chambresMax={chambresMax}
    piecesMin={piecesMin}
    piecesMax={piecesMax}
    surfaceMin={surfaceMin}
    surfaceMax={surfaceMax}
    dpe={dpe}
    meuble={meuble}
    equipements={equipements}
  />

  <button type="submit" class="rounded-lg bg-primary px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 lg:ml-auto">Rechercher</button>
</form>

<script>
  import { navigate } from 'astro:transitions/client';
  import { $filters } from '../../stores/filters';
  import { type Filters } from '../../types/filters';
  import { LAST_SEARCH_KEY } from '../../utils/lastSearch';
  import { $results, $isLoading } from '../../stores/results';

  document.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement | HTMLSelectElement;
    if (!(target.name in $filters.get())) return;
    $filters.setKey(target.name as keyof Filters, target.value);
  });

  const searchUrl = (): string => {
    const urlParams = new URLSearchParams();
    for (const [key, value] of Object.entries($filters.get())) {
      if (Array.isArray(value)) value.forEach((v) => urlParams.append(key, v));
      else if (value) urlParams.append(key, value);
    }

    const qs = urlParams.toString();
    return qs ? `/biens?${qs}` : '/biens';
  };

  const runSearch = () => {
    const url = searchUrl();
    document.addEventListener('astro:page-load', () => window.scrollTo({ top: 0, behavior: 'instant' }), { once: true });
    localStorage.setItem(LAST_SEARCH_KEY, url);
    navigate(url, { history: 'replace' });
  };

  const fetchResults = async () => {
    $isLoading.set(true);
    const url = searchUrl().replace('/biens', '/api/biens');
    const response = await fetch(url);
    $results.set(await response.json());
    $isLoading.set(false);
  };

  $filters.listen(() => {
    history.replaceState(null, '', searchUrl());
    fetchResults();
  });

  document.addEventListener('submit', (e) => {
    if (!(e.target as HTMLElement).closest('.search-form')) return;
    e.preventDefault();
    runSearch();
  });
</script>
