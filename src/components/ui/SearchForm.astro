---
// #region - frontmatter
import properties from '../../data/biens.json';
import type { Property } from '../../types/property';
import DetailsSearch from './DetailsSearch.astro';
import MoreFilter from './MoreFilter.astro';

interface Props {
  transaction?: string;
  ville?: string;
  type?: string;
  prixMin?: string;
  prixMax?: string;
  chambresMin?: string;
  chambresMax?: string;
  piecesMin?: string;
  piecesMax?: string;
  surfaceMin?: string;
  surfaceMax?: string;
  dpeMax?: string;
  meuble?: string;
  equipements?: string[];
}

const {
  transaction = '',
  ville = '',
  type = '',
  prixMin = '',
  prixMax = '',
  chambresMin = '',
  chambresMax = '',
  piecesMin = '',
  piecesMax = '',
  surfaceMin = '',
  surfaceMax = '',
  dpeMax = '',
  meuble = '',
  equipements = [],
} = Astro.props;

const cities = [...new Set((properties as Property[]).map((p) => p.ville))].sort();

const fieldClass = 'rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-primary';
const labelClass = 'mb-2 text-xs font-semibold text-gray-500';
// #endregion
---

<form method="get" data-live class="search-form container flex flex-col gap-4 py-4 lg:flex-row lg:flex-wrap lg:items-end lg:gap-y-0">
  <!-- Champs principaux -->
  <div class="flex flex-col gap-1">
    <label for="search-city" class={labelClass}>Choisir la localisation</label>
    <select id="search-city" name="ville" class:list={[fieldClass, 'w-full lg:w-56']}>
      <option value="">Toutes les localisations</option>
      {
        cities.map((c) => (
          <option value={c} selected={c === ville}>
            {c}
          </option>
        ))
      }
    </select>
  </div>

  <DetailsSearch name="prix" label="Budget" unit="€" width="lg:w-52" min={prixMin} max={prixMax} fieldClass={fieldClass} labelClass={labelClass} />

  <MoreFilter
    transaction={transaction}
    type={type}
    chambresMin={chambresMin}
    chambresMax={chambresMax}
    piecesMin={piecesMin}
    piecesMax={piecesMax}
    surfaceMin={surfaceMin}
    surfaceMax={surfaceMax}
    dpeMax={dpeMax}
    meuble={meuble}
    equipements={equipements}
    fieldClass={fieldClass}
    labelClass={labelClass}
  />

  <button type="submit" class="rounded-lg bg-primary px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 lg:ml-auto">Rechercher</button>
</form>

<script>
  import { navigate } from 'astro:transitions/client';
  import { LAST_SEARCH_KEY } from '../../utils/lastSearch';

  // Construit /biens?... à partir des champs remplis, en ignorant les champs vides
  const searchUrl = (form: HTMLFormElement): string => {
    const params = new URLSearchParams();
    for (const [key, value] of new FormData(form)) {
      if (value) params.append(key, String(value));
    }

    const qs = params.toString();
    return qs ? `/biens?${qs}` : '/biens';
  };

  // Le panneau de recherche est transition:persist (jamais remplacé par le serveur), donc le
  // texte affiché sur chaque <DetailsSearch> (Budget, Chambres...) ne se met jamais à jour tout
  // seul : on le refait ici à la main, pour chaque instance présente dans le formulaire.
  const updateDetailsLabels = (form: HTMLFormElement) => {
    form.querySelectorAll<HTMLDetailsElement>('.details-search').forEach((details) => {
      const { name, label = '', unit = '' } = details.dataset;
      const summary = details.querySelector('summary');
      const min = form.querySelector<HTMLInputElement>(`[name="${name}Min"]`)?.value;
      const max = form.querySelector<HTMLInputElement>(`[name="${name}Max"]`)?.value;
      const suffix = unit ? ` ${unit}` : '';
      if (summary) summary.textContent = min || max ? `${min || '0'}${suffix} - ${max || '∞'}${suffix}` : label;
    });
  };

  // Relance la recherche (changement de filtre ou clic "Rechercher") : URL propre,
  // sauvegarde locale, retour en haut, navigation sans rechargement
  const updateSearch = (e: Event) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>('.search-form');
    if (!form) return;
    e.preventDefault();

    updateDetailsLabels(form);
    const url = searchUrl(form);
    document.addEventListener('astro:page-load', () => window.scrollTo({ top: 0, behavior: 'instant' }), { once: true });

    localStorage.setItem(LAST_SEARCH_KEY, url);

    navigate(url, { history: 'replace' });
  };

  document.addEventListener('change', updateSearch);
  document.addEventListener('submit', updateSearch);
</script>
