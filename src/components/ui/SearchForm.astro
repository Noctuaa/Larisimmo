---
import properties from '../../data/biens.json';
import type { Property } from '../../types/property';

interface Props {
  transaction?: string;
  ville?: string;
  type?: string;
  prix?: string;
  chambresMin?: string;
  piecesMin?: string;
  surfaceMin?: string;
  dpeMax?: string;
  meuble?: string;
  equipements?: string[];
}

const {
  transaction = '',
  ville = '',
  type = '',
  prix = '',
  chambresMin = '',
  piecesMin = '',
  surfaceMin = '',
  dpeMax = '',
  meuble = '',
  equipements = [],
} = Astro.props;

// Champs principaux (toujours visibles)
const transactions = [
  { label: 'Achat', value: 'vente' },
  { label: 'Location', value: 'location' },
];
const cities = [...new Set((properties as Property[]).map((p) => p.ville))].sort();
const propertyTypes = ['Appartement', 'Maison'];
const priceRanges = [
  { label: "Jusqu'à 200 000 €", value: '0-200000' },
  { label: '200 000 € - 400 000 €', value: '200000-400000' },
  { label: '400 000 € - 600 000 €', value: '400000-600000' },
  { label: 'Plus de 600 000 €', value: '600000-' },
];

// Champs avancés (repliés derrière le bouton "Filtres")
const allEquipements = [...new Set((properties as Property[]).flatMap((p) => p.equipements))].sort();
const dpeClasses = ['A', 'B', 'C', 'D', 'E', 'F', 'G'];

const fieldClass = 'rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-primary';
const labelClass = 'text-xs font-semibold text-gray-500';

// Filtres repliés derrière le bouton "Filtres" : on compte ceux qui sont actifs pour le badge.
// Le panneau reste fermé au chargement en desktop même si des filtres sont actifs : le badge
// suffit à le signaler, on clique "Filtres" pour les voir/modifier.
const advancedFilters = [chambresMin, piecesMin, surfaceMin, dpeMax, meuble];
const activeCount = advancedFilters.filter(Boolean).length + (equipements.length ? 1 : 0);
---

<form method="get" data-live class="search-form container flex flex-col gap-4 py-4 lg:flex-row lg:flex-wrap lg:items-end lg:gap-y-0">
  <!-- Champs principaux -->
  <div class="flex flex-col gap-1">
    <label for="search-transaction" class={labelClass}>Achat ou location</label>
    <select id="search-transaction" name="transaction" class:list={[fieldClass, 'w-full lg:w-40']}>
      <option value="">Peu importe</option>
      {
        transactions.map((t) => (
          <option value={t.value} selected={t.value === transaction}>
            {t.label}
          </option>
        ))
      }
    </select>
  </div>

  <div class="flex flex-col gap-1">
    <label for="search-city" class={labelClass}>Choisir la localisation</label>
    <select id="search-city" name="ville" class:list={[fieldClass, 'w-full lg:w-56']}>
      <option value="">Toutes les localisations</option>
      {
        cities.map((c) => (
          <option value={c} selected={c === ville}>
            {c}
          </option>
        ))
      }
    </select>
  </div>

  <div class="flex flex-col gap-1">
    <label for="search-type" class={labelClass}>Type de bien</label>
    <select id="search-type" name="type" class:list={[fieldClass, 'w-full lg:w-40']}>
      <option value="">Tout type</option>
      {
        propertyTypes.map((t) => (
          <option value={t} selected={t === type}>
            {t}
          </option>
        ))
      }
    </select>
  </div>

  <div class="flex flex-col gap-1">
    <label for="search-price" class={labelClass}>Budget</label>
    <select id="search-price" name="prix" class:list={[fieldClass, 'w-full lg:w-52']}>
      <option value="">Tous les prix</option>
      {
        priceRanges.map((r) => (
          <option value={r.value} selected={r.value === prix}>
            {r.label}
          </option>
        ))
      }
    </select>
  </div>

  <button
    type="button"
    class="toggle-more-filters hidden items-center gap-2 rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 lg:flex"
    aria-expanded="false"
  >
    Filtres
    {
      activeCount > 0 && (
        <span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1.5 text-xs font-bold text-white">{activeCount}</span>
      )
    }
  </button>

  <!-- Champs avancés -->
  <div class="more-filters w-full lg:order-last">
    <div class="more-filters-panel flex flex-wrap items-end gap-4 border-t border-gray-100 pt-4">
      <div class="flex flex-col gap-1">
        <label for="filter-chambres" class={labelClass}>Chambres min.</label>
        <input type="number" id="filter-chambres" name="chambres" min="0" value={chambresMin} class:list={[fieldClass, 'w-28']} />
      </div>

      <div class="flex flex-col gap-1">
        <label for="filter-pieces" class={labelClass}>Pièces min.</label>
        <input type="number" id="filter-pieces" name="pieces" min="0" value={piecesMin} class:list={[fieldClass, 'w-28']} />
      </div>

      <div class="flex flex-col gap-1">
        <label for="filter-surface" class={labelClass}>Surface min. (m²)</label>
        <input type="number" id="filter-surface" name="surface" min="0" value={surfaceMin} class:list={[fieldClass, 'w-28']} />
      </div>

      <div class="flex flex-col gap-1">
        <label for="filter-dpe" class={labelClass}>DPE max.</label>
        <select id="filter-dpe" name="dpe" class:list={[fieldClass, 'w-40']}>
          <option value="">Indifférent</option>
          {
            dpeClasses.map((c) => (
              <option value={c} selected={c === dpeMax}>
                {c} ou mieux
              </option>
            ))
          }
        </select>
      </div>

      <div class="flex flex-col gap-1">
        <label for="filter-meuble" class={labelClass}>Meublé</label>
        <select id="filter-meuble" name="meuble" class:list={[fieldClass, 'w-40']}>
          <option value="">Indifférent</option>
          <option value="true" selected={meuble === 'true'}>Meublé</option>
          <option value="false" selected={meuble === 'false'}>Non meublé</option>
        </select>
      </div>

      <fieldset class="flex w-full flex-col gap-2">
        <legend class={labelClass}>Équipements</legend>
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          {
            allEquipements.map((eq) => (
              <label class="flex items-center gap-2 text-sm text-gray-700">
                <input
                  type="checkbox"
                  name="equipements"
                  value={eq}
                  checked={equipements.includes(eq)}
                  class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary"
                />
                {eq}
              </label>
            ))
          }
        </div>
      </fieldset>
    </div>
  </div>

  <button type="submit" class="rounded-lg bg-primary px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 lg:ml-auto">Rechercher</button>
</form>

<script>
  import { navigate } from 'astro:transitions/client';
  import { LAST_SEARCH_KEY } from '../../utils/lastSearch';

  // Construit /biens?... à partir des champs remplis, en ignorant les champs vides
  const searchUrl = (form: HTMLFormElement): string => {
    const params = new URLSearchParams();
    for (const [key, value] of new FormData(form)) {
      if (value) params.append(key, String(value));
    }

    const qs = params.toString();
    return qs ? `/biens?${qs}` : '/biens';
  };

  // Relance la recherche (changement de filtre ou clic "Rechercher") : URL propre,
  // sauvegarde locale, retour en haut, navigation sans rechargement
  const updateSearch = (e: Event) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>('.search-form');
    if (!form) return;
    e.preventDefault();

    const url = searchUrl(form);
    document.addEventListener('astro:page-load', () => window.scrollTo({ top: 0, behavior: 'instant' }), { once: true });

    localStorage.setItem(LAST_SEARCH_KEY, url);

    navigate(url, { history: 'replace' });
  };

  document.addEventListener('change', updateSearch);
  document.addEventListener('submit', updateSearch);

  // Ouvre/ferme le panneau "Filtres" au clic sur le bouton.
  document.addEventListener('click', (e) => {
    const toggle = (e.target as HTMLElement).closest<HTMLButtonElement>('.toggle-more-filters');
    if (!toggle) return;

    const panel = toggle.closest('.search-form')?.querySelector('.more-filters');
    const isOpen = panel?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>

<style>
  @media (min-width: 1024px) {
    .more-filters {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 300ms ease;
    }

    .more-filters.is-open {
      grid-template-rows: 1fr;
    }

    .more-filters-panel {
      overflow: hidden;
      /* sans ça, min-height: auto (défaut des items grid) empêche la piste de descendre sous 0fr */
      min-height: 0;
    }
  }
</style>
