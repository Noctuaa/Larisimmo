---
// #region - frontmatter
import properties from '../../data/biens.json';
import type { Property } from '../../types/property';
import MoreFilter from './MoreFilter.astro';

interface Props {
  transaction?: string;
  ville?: string;
  type?: string;
  prixMin?: string;
  prixMax?: string;
  chambresMin?: string;
  chambresMax?: string;
  piecesMin?: string;
  piecesMax?: string;
  surfaceMin?: string;
  surfaceMax?: string;
  dpeMax?: string;
  meuble?: string;
  equipements?: string[];
}

const {
  transaction = '',
  ville = '',
  type = '',
  prixMin = '',
  prixMax = '',
  chambresMin = '',
  chambresMax = '',
  piecesMin = '',
  piecesMax = '',
  surfaceMin = '',
  surfaceMax = '',
  dpeMax = '',
  meuble = '',
  equipements = [],
} = Astro.props;

// Champs principaux (toujours visibles)
const transactions = [
  { label: 'Achat', value: 'vente' },
  { label: 'Location', value: 'location' },
];
const cities = [...new Set((properties as Property[]).map((p) => p.ville))].sort();
const propertyTypes = ['Appartement', 'Maison', 'Chalet'];

const fieldClass = 'rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-primary';
const labelClass = 'mb-2 text-xs font-semibold text-gray-500';
// #endregion
---

<form method="get" data-live class="search-form container flex flex-col gap-4 py-4 lg:flex-row lg:flex-wrap lg:items-end lg:gap-y-0">
  <!-- Champs principaux -->
  <div class="flex flex-col gap-1">
    <label for="search-transaction" class={labelClass}>Achat ou location</label>
    <select id="search-transaction" name="transaction" class:list={[fieldClass, 'w-full lg:w-40']}>
      <option value="">Peu importe</option>
      {
        transactions.map((t) => (
          <option value={t.value} selected={t.value === transaction}>
            {t.label}
          </option>
        ))
      }
    </select>
  </div>

  <div class="flex flex-col gap-1">
    <label for="search-city" class={labelClass}>Choisir la localisation</label>
    <select id="search-city" name="ville" class:list={[fieldClass, 'w-full lg:w-56']}>
      <option value="">Toutes les localisations</option>
      {
        cities.map((c) => (
          <option value={c} selected={c === ville}>
            {c}
          </option>
        ))
      }
    </select>
  </div>

  <div class="flex flex-col gap-1">
    <label for="search-type" class={labelClass}>Type de bien</label>
    <select id="search-type" name="type" class:list={[fieldClass, 'w-full lg:w-40']}>
      <option value="">Tout type</option>
      {
        propertyTypes.map((t) => (
          <option value={t} selected={t === type}>
            {t}
          </option>
        ))
      }
    </select>
  </div>

  <MoreFilter
    transaction={transaction}
    chambresMin={chambresMin}
    chambresMax={chambresMax}
    piecesMin={piecesMin}
    piecesMax={piecesMax}
    surfaceMin={surfaceMin}
    surfaceMax={surfaceMax}
    dpeMax={dpeMax}
    meuble={meuble}
    equipements={equipements}
    fieldClass={fieldClass}
    labelClass={labelClass}
  />

  <button type="submit" class="rounded-lg bg-primary px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 lg:ml-auto">Rechercher</button>
</form>

<script>
  import { navigate } from 'astro:transitions/client';
  import { $filters, type Filters } from '../../stores/filters';
  import { LAST_SEARCH_KEY } from '../../utils/lastSearch';

  document.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement | HTMLSelectElement;
    if (!(target.name in $filters.get())) return;

    if (target.name === 'equipements') {
      const checked = document.querySelectorAll<HTMLInputElement>('input[name="equipements"]:checked');
      $filters.setKey(
        'equipements',
        [...checked].map((el) => el.value),
      );
      return;
    }

    const isUnchecked = target instanceof HTMLInputElement && target.type === 'checkbox' && !target.checked;
    $filters.setKey(target.name as keyof Filters, isUnchecked ? '' : target.value);
  });

  $filters.subscribe((filters) => console.log(filters));
  const params = new URLSearchParams(window.location.search);
  for (const key of Object.keys($filters.get()) as (keyof Filters)[]) {
    $filters.setKey(key, key === 'equipements' ? params.getAll(key) : (params.get(key) ?? ''));
  }

  const searchUrl = (): string => {
    const urlParams = new URLSearchParams();
    for (const [key, value] of Object.entries($filters.get())) {
      if (Array.isArray(value)) value.forEach((v) => urlParams.append(key, v));
      else if (value) urlParams.append(key, value);
    }

    const qs = urlParams.toString();
    return qs ? `/biens?${qs}` : '/biens';
  };

  const runSearch = () => {
    const url = searchUrl();
    document.addEventListener('astro:page-load', () => window.scrollTo({ top: 0, behavior: 'instant' }), { once: true });
    localStorage.setItem(LAST_SEARCH_KEY, url);
    navigate(url, { history: 'replace' });
  };

  $filters.listen(runSearch);

  document.addEventListener('submit', (e) => {
    if (!(e.target as HTMLElement).closest('.search-form')) return;
    e.preventDefault();
    runSearch();
  });
</script>
