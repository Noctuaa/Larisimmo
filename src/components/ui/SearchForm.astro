---
import SearchFields from '../home/SearchFields.astro';
import AdvancedFilters from './AdvancedFilters.astro';

interface Props {
  transaction?: string;
  ville?: string;
  type?: string;
  prix?: string;
  chambresMin?: string;
  piecesMin?: string;
  surfaceMin?: string;
  dpeMax?: string;
  meuble?: string;
  equipements?: string[];
}

const {
  transaction = '',
  ville = '',
  type = '',
  prix = '',
  chambresMin = '',
  piecesMin = '',
  surfaceMin = '',
  dpeMax = '',
  meuble = '',
  equipements = [],
} = Astro.props;

// Filtres repliés derrière le bouton "Filtres" : on compte ceux qui sont actifs pour le badge.
// Le panneau reste fermé au chargement en desktop même si des filtres sont actifs : le badge
// suffit à le signaler, on clique "Filtres" pour les voir/modifier.
const advancedFilters = [chambresMin, piecesMin, surfaceMin, dpeMax, meuble];
const activeCount = advancedFilters.filter(Boolean).length + (equipements.length ? 1 : 0);
---

<!-- Mobile : barre pleine largeur qui ouvre la recherche, intégrée à la page plutôt que
     flottante (contrairement à la pill de la homepage qui repose sur la photo du Hero).
     mt-(--nav-height) : contrairement à la homepage, rien ici ne compense la hauteur du header fixe -->
<div class="sticky top-0 z-60 mt-(--nav-height) border-b border-gray-100 bg-background px-5 py-4 lg:hidden">
  <button id="search-trigger" type="button" class="flex w-full items-center gap-3 rounded-lg border border-gray-200 bg-white px-4 py-3 text-left">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="shrink-0 text-primary"
    >
      <path d="m21 21-4.34-4.34"></path>
      <circle cx="11" cy="11" r="8"></circle>
    </svg>
    <span class="text-sm text-gray-500">Rechercher un bien...</span>
  </button>
</div>

<!-- Panneau : glisse depuis le haut + plein écran en mobile (état géré en CSS), barre collée
     sous le header en desktop (contrairement à la homepage, pas de carte flottante ici) -->
<div
  id="search-panel"
  class="fixed inset-0 z-100 flex -translate-y-full flex-col bg-white pointer-events-none transition duration-300
  lg:sticky lg:top-0 lg:z-60 lg:mt-(--nav-height) lg:w-full lg:translate-y-0 lg:flex-row lg:items-end lg:gap-4 lg:border-b lg:border-t lg:border-gray-100 lg:bg-background lg:opacity-100 lg:pointer-events-auto lg:shadow-md"
>
  <!-- Barre de titre : mobile uniquement -->
  <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4 lg:hidden">
    <span class="text-lg font-bold text-primary">Rechercher</span>
    <button
      id="search-close"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full text-gray-700 hover:bg-gray-100"
      aria-label="Fermer la recherche"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Un seul conteneur flex : en mobile tout s'empile dans l'ordre du DOM (champs → filtres
       avancés → Rechercher), en desktop `lg:order-last` renvoie le bloc avancé en 2e ligne et
       `lg:ml-auto` garde Rechercher à droite de la 1re -->
  <form method="get" class="search-form container flex flex-col gap-4 py-4 lg:flex-row lg:flex-wrap lg:items-end lg:gap-y-0">
    <SearchFields transaction={transaction} ville={ville} type={type} prix={prix} />

    <button
      type="button"
      class="toggle-more-filters hidden items-center gap-2 rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 lg:flex"
      aria-expanded="false"
    >
      Filtres
      {
        activeCount > 0 && (
          <span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1.5 text-xs font-bold text-white">
            {activeCount}
          </span>
        )
      }
    </button>

    <!-- Sur mobile (panel plein écran) tous les filtres restent visibles ; en desktop ce bloc est
         replié par défaut et le toggle "Filtres" ajoute/retire `.is-open` (animation dans <style>).
         lg:order-last : renvoie ce bloc pleine largeur en 2e ligne, après le bouton Rechercher.
         Le div interne .more-filters-panel porte le contenu : en desktop il est la "piste" que
         grid-template-rows fait passer de 0fr à 1fr. -->
    <div class="more-filters w-full lg:order-last">
      <div class="more-filters-panel flex flex-wrap items-end gap-4 border-t border-gray-100 pt-4">
        <AdvancedFilters
          chambresMin={chambresMin}
          piecesMin={piecesMin}
          surfaceMin={surfaceMin}
          dpeMax={dpeMax}
          meuble={meuble}
          equipements={equipements}
        />
      </div>
    </div>

    <button type="submit" class="rounded-lg bg-primary px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 lg:ml-auto">
      Rechercher
    </button>
  </form>
</div>

<script>
  import '../../utils/searchPanelToggle';
  import '../../utils/searchFormSubmit';

  // Délégation sur document plutôt que des références capturées une fois : avec
  // <ClientRouter /> ce script ne s'exécute qu'une fois pour tout le site, alors que
  // form/toggle sont remplacés par de nouveaux éléments à chaque navigation.
  document.addEventListener('click', (e) => {
    const toggle = (e.target as HTMLElement).closest<HTMLButtonElement>('.toggle-more-filters');
    if (!toggle) return;

    const panel = toggle.closest('.search-form')?.querySelector('.more-filters');
    const isOpen = panel?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>

<style>
  /* Repli/dépli animé du panneau filtres — desktop uniquement (mobile : toujours visible).
     Technique grid-template-rows 0fr → 1fr : les unités fr s'interpolent proprement,
     contrairement à height: auto qui saccade avec du contenu flex. */
  @media (min-width: 1024px) {
    .more-filters {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 300ms ease;
    }

    .more-filters.is-open {
      grid-template-rows: 1fr;
    }

    .more-filters-panel {
      overflow: hidden;
      /* sans ça, min-height: auto (défaut des items grid) empêche la piste de descendre sous 0fr */
      min-height: 0;
    }
  }
</style>
