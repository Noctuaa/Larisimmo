---
import SearchFields from '../home/SearchFields.astro';

interface Props {
  ville?: string;
  type?: string;
  prix?: string;
  chambresMin?: string;
  surfaceMin?: string;
}

const { ville = '', type = '', prix = '', chambresMin = '', surfaceMin = '' } = Astro.props;
const filtersOpen = !!chambresMin || !!surfaceMin;
---

<!-- Mobile : barre pleine largeur qui ouvre la recherche, intégrée à la page plutôt que
     flottante (contrairement à la pill de la homepage qui repose sur la photo du Hero).
     mt-(--nav-height) : contrairement à la homepage, rien ici ne compense la hauteur du header fixe -->
<div class="sticky top-0 z-60 mt-(--nav-height) border-b border-gray-100 bg-background px-5 py-4 lg:hidden">
  <button id="search-trigger" type="button" class="flex w-full items-center gap-3 rounded-lg border border-gray-200 bg-white px-4 py-3 text-left">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="shrink-0 text-primary"
    >
      <path d="m21 21-4.34-4.34"></path>
      <circle cx="11" cy="11" r="8"></circle>
    </svg>
    <span class="text-sm text-gray-500">Rechercher un bien...</span>
  </button>
</div>

<!-- Panneau : glisse depuis le haut + plein écran en mobile (état géré en CSS), barre collée
     sous le header en desktop (contrairement à la homepage, pas de carte flottante ici) -->
<div
  id="search-panel"
  class="fixed inset-0 z-100 flex -translate-y-full flex-col bg-white pointer-events-none transition duration-300
  lg:sticky lg:top-0 lg:z-60 lg:mt-(--nav-height) lg:w-full lg:translate-y-0 lg:flex-row lg:items-end lg:gap-4 lg:border-b lg:border-t lg:border-gray-100 lg:bg-background lg:opacity-100 lg:pointer-events-auto lg:shadow-md"
>
  <!-- Barre de titre : mobile uniquement -->
  <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4 lg:hidden">
    <span class="text-lg font-bold text-primary">Rechercher</span>
    <button
      id="search-close"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full text-gray-700 hover:bg-gray-100"
      aria-label="Fermer la recherche"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <form method="get" class="search-form container flex flex-col gap-4 py-4">
    <div class="flex flex-wrap items-end gap-4">
      <SearchFields ville={ville} type={type} prix={prix} />

      <button
        type="button"
        class="toggle-more-filters hidden items-center gap-2 rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 lg:flex"
        aria-expanded={filtersOpen}
      >
        Filtres
      </button>

      <button type="submit" class="ml-auto rounded-lg bg-primary px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90">Rechercher</button>
    </div>

    <!-- Sur mobile (dans le panel plein écran) tous les filtres restent visibles ; en desktop le
         toggle "Plus de filtres" ci-dessus les masque/affiche via la classe lg:hidden -->
    <div class:list={['more-filters flex flex-wrap gap-4 border-t border-gray-100 pt-4', { 'lg:hidden': !filtersOpen }]}>
      <div class="flex flex-col gap-1">
        <label for="filter-chambres" class="text-xs font-semibold text-gray-500">Chambres min.</label>
        <input
          type="number"
          id="filter-chambres"
          name="chambres"
          min="0"
          value={chambresMin}
          class="w-28 rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-primary"
        />
      </div>
      <div class="flex flex-col gap-1">
        <label for="filter-surface" class="text-xs font-semibold text-gray-500">Surface min. (m²)</label>
        <input
          type="number"
          id="filter-surface"
          name="surface"
          min="0"
          value={surfaceMin}
          class="w-28 rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-primary"
        />
      </div>
    </div>
  </form>
</div>

<script>
  import '../../utils/searchPanelToggle';
  import '../../utils/searchFormSubmit';

  // Délégation sur document plutôt que des références capturées une fois : avec
  // <ClientRouter /> ce script ne s'exécute qu'une fois pour tout le site, alors que
  // form/toggle sont remplacés par de nouveaux éléments à chaque navigation.
  document.addEventListener('click', (e) => {
    const toggle = (e.target as HTMLElement).closest<HTMLButtonElement>('.toggle-more-filters');
    if (!toggle) return;

    const panel = toggle.closest('.search-form')?.querySelector('.more-filters');
    const isHidden = panel?.classList.toggle('lg:hidden') ?? false;
    toggle.setAttribute('aria-expanded', String(!isHidden));
  });
</script>
