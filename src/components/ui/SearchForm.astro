---
import SearchFields from '../home/SearchFields.astro';

interface Props {
  ville?: string;
  type?: string;
  prix?: string;
  chambresMin?: string;
  surfaceMin?: string;
  /** Soumet le formulaire dès qu'un filtre change, sans passer par le bouton (utilisé sur /biens) */
  autoSubmit?: boolean;
}

const { ville = '', type = '', prix = '', chambresMin = '', surfaceMin = '', autoSubmit = false } = Astro.props;
const filtersOpen = !!chambresMin || !!surfaceMin;
---

<form method="get" class="search-form container flex flex-col gap-4 py-4" data-auto-submit={autoSubmit}>
  <div class="flex flex-wrap items-end gap-4">
    <SearchFields ville={ville} type={type} prix={prix} />

    <button
      type="button"
      class="toggle-more-filters flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50"
      aria-expanded={filtersOpen}
    >
      Plus de filtres
    </button>

    {
      !autoSubmit && (
        <button type="submit" class="ml-auto rounded-lg bg-primary px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90">
          Rechercher
        </button>
      )
    }
  </div>

  <div class:list={['more-filters flex flex-wrap gap-4 border-t border-gray-100 pt-4', { hidden: !filtersOpen }]}>
    <div class="flex flex-col gap-1">
      <label for="filter-chambres" class="text-xs font-semibold text-gray-500">Chambres min.</label>
      <input
        type="number"
        id="filter-chambres"
        name="chambres"
        min="0"
        value={chambresMin}
        class="w-28 rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-primary"
      />
    </div>
    <div class="flex flex-col gap-1">
      <label for="filter-surface" class="text-xs font-semibold text-gray-500">Surface min. (m²)</label>
      <input
        type="number"
        id="filter-surface"
        name="surface"
        min="0"
        value={surfaceMin}
        class="w-28 rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-primary"
      />
    </div>
  </div>
</form>

<script>
  // Délégation sur document plutôt que des références capturées une fois : avec
  // <ClientRouter /> ce script ne s'exécute qu'une fois pour tout le site, alors que
  // le form/toggle/panel sont remplacés par de nouveaux éléments à chaque navigation.
  document.addEventListener('click', (e) => {
    const toggle = (e.target as HTMLElement).closest<HTMLButtonElement>('.toggle-more-filters');
    if (!toggle) return;

    const panel = toggle.closest('.search-form')?.querySelector('.more-filters');
    const isHidden = panel?.classList.toggle('hidden') ?? false;
    toggle.setAttribute('aria-expanded', String(!isHidden));
  });

  document.addEventListener('change', (e) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>('.search-form');
    if (form?.dataset.autoSubmit === 'true') {
      form.requestSubmit();
    }
  });
</script>
