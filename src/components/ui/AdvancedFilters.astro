---
import properties from '../../data/biens.json';
import type { Property } from '../../types/property';

interface Props {
  chambresMin?: string;
  piecesMin?: string;
  surfaceMin?: string;
  dpeMax?: string;
  meuble?: string;
  equipements?: string[];
}

const { chambresMin = '', piecesMin = '', surfaceMin = '', dpeMax = '', meuble = '', equipements = [] } = Astro.props;

const allEquipements = [...new Set((properties as Property[]).flatMap((p) => p.equipements))].sort();
const dpeClasses = ['A', 'B', 'C', 'D', 'E', 'F', 'G'];

const numberField = 'w-28 rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-primary';
const selectField = 'w-40 rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-primary';
const labelClass = 'text-xs font-semibold text-gray-500';
---

<div class="flex flex-col gap-1">
  <label for="filter-chambres" class={labelClass}>Chambres min.</label>
  <input type="number" id="filter-chambres" name="chambres" min="0" value={chambresMin} class={numberField} />
</div>

<div class="flex flex-col gap-1">
  <label for="filter-pieces" class={labelClass}>Pièces min.</label>
  <input type="number" id="filter-pieces" name="pieces" min="0" value={piecesMin} class={numberField} />
</div>

<div class="flex flex-col gap-1">
  <label for="filter-surface" class={labelClass}>Surface min. (m²)</label>
  <input type="number" id="filter-surface" name="surface" min="0" value={surfaceMin} class={numberField} />
</div>

<div class="flex flex-col gap-1">
  <label for="filter-dpe" class={labelClass}>DPE max.</label>
  <select id="filter-dpe" name="dpe" class={selectField}>
    <option value="">Indifférent</option>
    {
      dpeClasses.map((c) => (
        <option value={c} selected={c === dpeMax}>
          {c} ou mieux
        </option>
      ))
    }
  </select>
</div>

<div class="flex flex-col gap-1">
  <label for="filter-meuble" class={labelClass}>Meublé</label>
  <select id="filter-meuble" name="meuble" class={selectField}>
    <option value="">Indifférent</option>
    <option value="true" selected={meuble === 'true'}>Meublé</option>
    <option value="false" selected={meuble === 'false'}>Non meublé</option>
  </select>
</div>

<fieldset class="flex w-full flex-col gap-2">
  <legend class={labelClass}>Équipements</legend>
  <div class="flex flex-wrap gap-x-4 gap-y-2">
    {
      allEquipements.map((eq) => (
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <input
            type="checkbox"
            name="equipements"
            value={eq}
            checked={equipements.includes(eq)}
            class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary"
          />
          {eq}
        </label>
      ))
    }
  </div>
</fieldset>
