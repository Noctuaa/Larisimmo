---
// #region - frontmatter
interface Props {
  // Préfixe des name : "chambres" -> "chambresMin" / "chambresMax"
  name: string;
  title: string;
  min?: string;
  max?: string;
}

const { name, title, min = '', max = '' } = Astro.props;

const values = [1, 2, 3, 4, 5, 6, 7, 8];

// Le "8+" du Max veut dire "sans limite" : il envoie 99 (et pas 8, qui exclurait les biens de 9+)
const NO_LIMIT = 99;

// Pastille : le radio est caché (sr-only) mais reste focusable/accessible, le label fait office de bouton
const pillClass =
  'flex h-10 min-w-10 cursor-pointer items-center justify-center rounded-full border border-gray-200 px-3 text-sm text-gray-700 hover:bg-gray-50 has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-white has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-40 has-[:disabled]:hover:bg-transparent';
// #endregion
---

<section data-range={name} class="flex flex-col gap-4 pb-6 border-b border-gray-300">
  <h3>{title}</h3>

  <!-- Rangée Min -->
  <fieldset class="flex flex-col gap-2">
    <legend class="mb-2 text-xs font-semibold text-gray-500">Min.</legend>
    <div class="flex flex-wrap gap-2">
      {
        values.map((n) => (
          <label class={pillClass}>
            <input type="radio" name={`${name}Min`} value={n} checked={min === String(n)} class="sr-only" />
            {n === 8 ? '8+' : n}
          </label>
        ))
      }
    </div>
  </fieldset>

  <!-- Rangée Max -->
  <fieldset class="flex flex-col gap-2">
    <legend class="mb-2 text-xs font-semibold text-gray-500">Max.</legend>
    <div class="flex flex-wrap gap-2">
      {
        values.map((n) => (
          <label class={pillClass}>
            <input
              type="radio"
              name={`${name}Max`}
              value={n === 8 ? NO_LIMIT : n}
              checked={n === 8 ? Number(max) >= 8 : max === String(n)}
              class="sr-only"
            />
            {n === 8 ? '8+' : n}
          </label>
        ))
      }
    </div>
  </fieldset>
</section>

<script>
  // Empêche une plage impossible (ex : Min 4 avec Max 2) : dans chaque rangée, on désactive
  // les pastilles incompatibles avec la valeur choisie dans l'autre rangée.
  const syncRange = (name: string) => {
    const min = document.querySelector<HTMLInputElement>(`input[name="${name}Min"]:checked`);
    const max = document.querySelector<HTMLInputElement>(`input[name="${name}Max"]:checked`);

    document.querySelectorAll<HTMLInputElement>(`input[name="${name}Min"]`).forEach((radio) => {
      radio.disabled = max !== null && Number(radio.value) > Number(max.value);
    });

    document.querySelectorAll<HTMLInputElement>(`input[name="${name}Max"]`).forEach((radio) => {
      radio.disabled = min !== null && Number(radio.value) < Number(min.value);
    });
  };

  // À chaque choix d'une pastille, on resynchronise le champ concerné (retrouvé via data-range)
  document.addEventListener('change', (e) => {
    const range = (e.target as HTMLElement).closest<HTMLElement>('[data-range]');
    if (range) syncRange(range.dataset.range!);
  });

  // Au chargement : une page ouverte avec ?chambresMin=4 doit déjà griser les Max de 1 à 3
  document.querySelectorAll<HTMLElement>('[data-range]').forEach((range) => syncRange(range.dataset.range!));
</script>
