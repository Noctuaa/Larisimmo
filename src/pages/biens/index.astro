---
export const prerender = false;

import properties from '../../data/biens.json';
import type { Property } from '../../types/property';
import { filterProperties } from '../../utils/filterProperties';
import { buildSearchUrl, parseFilters } from '../../utils/filtersUrl';

import Layout from '../../layouts/Layout.astro';
import PropertyList from '../../components/search/PropertyList.vue';
import SearchForm from '../../components/search/SearchForm.vue';

const params = Astro.url.searchParams;

// Les filtres lus dans l'adresse ; les clés correspondent exactement aux props attendues par <SearchForm>
const filters = parseFilters(params);

const { items, total, page: currentPage, totalPages } = filterProperties(properties as Property[], filters, Number(params.get('page')) || 1);

// Construit un lien vers /biens en conservant les filtres actuels, avec un param en plus/écrasé
const pageLink = (page: number) => buildSearchUrl(filters, '/biens', page);
---

<Layout>
  <div
    id="search-panel"
    class="sticky top-0 z-40 mb-(--nav-height) translate-y-(--nav-height) w-full border-y border-gray-100 bg-background shadow-md
  transition-transform duration-300 [body:has(header.-translate-y-full)_&]:translate-y-0"
  >
    <SearchForm client:load transition:persist="search-form" filters={filters} total={total} />
  </div>

  <main class="container py-12">
    <div class="mb-8">
      <p class="text-sm font-semibold text-accent">À la une</p>
      <h1 class="mt-2 text-3xl font-bold text-gray-900">Tous les biens</h1>
      <p class="mt-2 text-gray-600">{total} bien{total > 1 ? 's' : ''} trouvé{total > 1 ? 's' : ''}</p>
    </div>

    <PropertyList client:load items={items} id="results" />

    {
      totalPages > 1 && (
        <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
            <a
              href={pageLink(page)}
              class:list={[
                'flex h-10 w-10 items-center justify-center rounded-lg text-sm font-semibold transition',
                page === currentPage ? 'bg-primary text-white' : 'text-gray-700 hover:bg-gray-100',
              ]}
            >
              {page}
            </a>
          ))}
        </nav>
      )
    }
  </main>
</Layout>
