---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import PropertyCard from '../../components/cards/PropertyCard.astro';
import SearchForm from '../../components/ui/SearchForm.astro';
import properties from '../../data/biens.json';
import type { Property } from '../../types/property';

const params = Astro.url.searchParams;

const ville = params.get('ville') ?? '';
const type = params.get('type') ?? '';
const transaction = params.get('transaction') ?? '';
const prix = params.get('prix') ?? '';
const chambresMin = params.get('chambres') ?? '';
const piecesMin = params.get('pieces') ?? '';
const surfaceMin = params.get('surface') ?? '';
const dpeMax = params.get('dpe') ?? '';
const meuble = params.get('meuble') ?? '';
// Équipements : coché = plusieurs `equipements=` dans l'URL, le bien doit tous les avoir
const equipements = params.getAll('equipements');

const dpeOrder = ['A', 'B', 'C', 'D', 'E', 'F', 'G'];

const filtered = (properties as Property[]).filter((p) => {
  if (ville && p.ville !== ville) return false;
  if (type && p.type !== type) return false;
  if (transaction && p.transaction !== transaction) return false;
  if (prix) {
    const [min, max] = prix.split('-');
    if (min && p.prix < Number(min)) return false;
    if (max && p.prix > Number(max)) return false;
  }
  if (chambresMin && p.chambres < Number(chambresMin)) return false;
  if (piecesMin && p.pieces < Number(piecesMin)) return false;
  if (surfaceMin && p.surface < Number(surfaceMin)) return false;
  if (dpeMax && dpeOrder.indexOf(p.dpe) > dpeOrder.indexOf(dpeMax)) return false;
  if (meuble && String(p.meuble) !== meuble) return false;
  if (equipements.length && !equipements.every((e) => p.equipements.includes(e))) return false;
  return true;
});

const perPage = 12;
const totalPages = Math.max(1, Math.ceil(filtered.length / perPage));
const currentPage = Math.min(Math.max(1, Number(params.get('page')) || 1), totalPages);
const paginated = filtered.slice((currentPage - 1) * perPage, currentPage * perPage);

// Construit un lien vers /biens en conservant les filtres actuels, avec un param en plus/écrasé
const pageLink = (page: number) => {
  const p = new URLSearchParams(params);
  p.set('page', String(page));
  return `/biens?${p.toString()}`;
};
---

<Layout>
  <div class="sticky top-0 z-60 mt-(--nav-height) border-b border-gray-100 bg-background px-5 py-4 lg:hidden">
    <button id="search-trigger" type="button" class="flex w-full items-center gap-3 rounded-lg border border-gray-200 bg-white px-4 py-3 text-left">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="shrink-0 text-primary"
      >
        <path d="m21 21-4.34-4.34"></path>
        <circle cx="11" cy="11" r="8"></circle>
      </svg>
      <span class="text-sm text-gray-500">Rechercher un bien...</span>
    </button>
  </div>

  <div
    id="search-panel"
    transition:persist="search-panel"
    class="fixed inset-0 z-100 flex -translate-y-full flex-col bg-white pointer-events-none transition duration-300
    lg:sticky lg:top-0 lg:z-60 lg:mt-(--nav-height) lg:w-full lg:translate-y-0 lg:flex-row lg:items-end lg:gap-4 lg:border-b lg:border-t
    lg:border-gray-100 lg:bg-background lg:opacity-100 lg:pointer-events-auto lg:shadow-md"
  >
    <!-- Barre de titre : mobile uniquement -->
    <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4 lg:hidden">
      <span class="text-lg font-bold text-primary">Rechercher</span>
      <button
        id="search-close"
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-full text-gray-700 hover:bg-gray-100"
        aria-label="Fermer la recherche"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <SearchForm
      transaction={transaction}
      ville={ville}
      type={type}
      prix={prix}
      chambresMin={chambresMin}
      piecesMin={piecesMin}
      surfaceMin={surfaceMin}
      dpeMax={dpeMax}
      meuble={meuble}
      equipements={equipements}
    />
  </div>

  <main class="container py-12">
    <div class="mb-8">
      <p class="text-sm font-semibold text-accent">À la une</p>
      <h1 class="mt-2 text-3xl font-bold text-gray-900">Tous les biens</h1>
      <p class="mt-2 text-gray-600">{filtered.length} bien{filtered.length > 1 ? 's' : ''} trouvé{filtered.length > 1 ? 's' : ''}</p>
    </div>

    {
      paginated.length > 0 ? (
        <div class="grid grid-fill gap-8">
          {paginated.map((property) => (
            <PropertyCard property={property} />
          ))}
        </div>
      ) : (
        <p class="text-center text-gray-500">Aucun bien ne correspond à votre recherche.</p>
      )
    }

    {
      totalPages > 1 && (
        <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
            <a
              href={pageLink(page)}
              class:list={[
                'flex h-10 w-10 items-center justify-center rounded-lg text-sm font-semibold transition',
                page === currentPage ? 'bg-primary text-white' : 'text-gray-700 hover:bg-gray-100',
              ]}
            >
              {page}
            </a>
          ))}
        </nav>
      )
    }
  </main>
</Layout>

<script>
  // Ouvre/ferme le panneau de recherche mobile (#search-panel) de SearchForm via
  // #search-trigger / #search-close.
  //
  // Délégation sur document plutôt que des références capturées une fois : avec <ClientRouter />
  // ce script ne s'exécute qu'une seule fois pour tout le site, alors que trigger/closeBtn/panel
  // sont remplacés par de nouveaux éléments à chaque navigation qui revient sur /biens.
  const hiddenClasses = ['-translate-y-full', 'pointer-events-none'];

  const toggleSearch = () => {
    const panel = document.getElementById('search-panel');
    const isHidden = panel?.classList.contains('-translate-y-full');
    panel?.classList[isHidden ? 'remove' : 'add'](...hiddenClasses);
    document.body.classList.toggle('overflow-hidden');
  };

  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('#search-trigger, #search-close');
    if (target) toggleSearch();
  });
</script>
