---
// #region Astro frontmatter
export const prerender = false;

import properties from '@/data/biens.json';
import type { Property } from '@/schemas/property';
import { propertyTypeLabels } from '@/data/filterOptions';
import Layout from '@/layouts/Layout.astro';
import { dpeColors } from '@/data/dpeColors';
import { getCharacteristics } from '@/data/propertyFields';
import { equipementMeta } from '@/data/fieldMeta';

const { id } = Astro.params;

// On cherche le bien dont l'id correspond à celui passé dans l'URL
const property = (properties as Property[]).find((p) => p.id === id);

// Si aucun bien n'est trouvé, on renvoie une erreur 404
if (!property) Astro.response.status = 404;

// La description est en paragraphes séparés par une ligne vide : le premier reste visible, les suivants sont repliés (« Voir plus »)
const [intro, ...suite] = property?.description.split('\n\n') ?? [];

// Couleurs des étiquettes (même chose que sur la carte pour l'instant, on les partagera ensuite)
const tagStyles: Record<string, string> = {
  Nouveau: 'bg-primary text-white',
  'Bon plan': 'bg-emerald-500 text-white',
  'Coup de cœur': 'bg-rose-500 text-white',
};

// Prix avec « / mois » en location
const formatPrice = (p: Property) => {
  const formatted = p.prix.toLocaleString('fr-FR');
  return p.transaction === 'rent' ? `${formatted} € / mois` : `${formatted} €`;
};

// Les caractéristiques simples (surface, pièces…) : la page les parcourt en boucle
const characteristics = property ? getCharacteristics(property) : [];
// #endregion
---

<Layout>
  <main class="container pt-[calc(var(--nav-height)+3rem)] pb-12">
    {property ? (
      <div class="grid gap-8 lg:grid-cols-[2fr_1fr]">
        <article class="flex flex-col gap-6">
          <img
            src={property.photos[0].grande}
            alt={`Photo de ${property.titre}`}
            fetchpriority="high"
            class="aspect-4/3 w-full rounded-2xl object-cover md:aspect-video"
          />

          <header class="flex flex-col gap-3">
            <p class="font-bold text-accent">
              {propertyTypeLabels[property.type]} à {property.transaction === 'rent' ? 'louers' : 'vendre'}{' '}
            </p>
            <div class="flex gap-3 flex-wrap">
              <p class="text-xl font-bold text-primary">{formatPrice(property)}</p>
              <ul class="flex flex-wrap items-center gap-2">
                {property.etiquettes.map((tag) => (
                  <li class:list={['rounded-full px-3 py-1 text-xs font-semibold', tagStyles[tag]]}>{tag}</li>
                ))}
              </ul>
            </div>
          </header>

          <section class="flex flex-col gap-2">
            <h1 class="text-xl font-bold text-gray-900 md:text-xl">{property.titre}</h1>
            <p class="text-gray-600">{intro}</p>
            {suite.length > 0 && (
              <details class="group flex flex-col-reverse details-animated">
                <summary class="cursor-pointer list-none text-sm font-semibold text-primary [&::-webkit-details-marker]:hidden">
                  <span class="group-open:hidden">Voir plus</span>
                  <span class="hidden group-open:inline">Voir moins</span>
                </summary>
                <div class="flex flex-col gap-3 pb-3 text-gray-600">
                  {suite.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </details>
            )}
          </section>

          <hr class="border-gray-200" />

          <section class="flex flex-col gap-4">
            <h2 class="text-lg font-semibold text-gray-900">Caractéristiques</h2>
            <dl class="grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-3">
              {characteristics.map(({ icon: Icon, ...item }) => (
                <div class="flex flex-col gap-1">
                  <dt class="flex items-center gap-2 text-sm text-gray-500">
                    <Icon class="size-4" aria-hidden="true" />
                    {item.label}
                  </dt>
                  <dd class="font-medium text-gray-900">
                    {item.kind === 'dpe' ? (
                      <span class:list={['dpe-tag size-6', dpeColors[item.value]]} aria-label={`${item.label} ${item.value}`}>
                        {item.value}
                      </span>
                    ) : (
                      item.value
                    )}
                  </dd>
                </div>
              ))}
            </dl>{' '}
            <h3 class="text-base font-semibold text-gray-900">Équipements</h3>
            <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-gray-600 sm:grid-cols-3">
              {property.equipements.map((equipement) => {
                const { icon: Icon, label } = equipementMeta[equipement];
                return (
                  <li class="flex items-center gap-2">
                    <Icon class="size-4 text-primary" aria-hidden="true" />
                    {label}
                  </li>
                );
              })}
            </ul>
          </section>

          <hr class="border-gray-200" />
        </article>

        <aside class="lg:sticky lg:top-[calc(var(--nav-height)+1rem)] lg:self-start">
          <div class="flex flex-col gap-3 rounded-2xl border border-gray-200 bg-white p-6 shadow-md">
            <p class="font-semibold text-gray-900">Ce bien vous intéresse ?</p>
            <button type="button" disabled class="btn btn-primary cursor-not-allowed opacity-50">
              Contacter
            </button>
          </div>
        </aside>
      </div>
    ) : (
      <h1 class="text-3xl font-bold">Bien introuvable</h1>
    )}
  </main>
</Layout>
